# ── Server ──────────────────────────────
PORT=5001
NODE_ENV=development
# Frontend origin used to build password-reset links in emails
FRONTEND_URL=http://localhost:5173

# ── Database (MySQL / XAMPP) ────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=book_store

# ── Auth ────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ── Redis (optional — app runs without it) ─
REDIS_URL=redis://127.0.0.1:6379

# ── Cloudinary (image uploads) ──────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Stripe (optional — checkout works without real keys) ─
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Email / SMTP (optional) ─────────────
# Leave blank to run in MOCK mode (emails are logged to the console).
# Fill these to send real password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BookShop <no-reply@bookshop.com>"
